# Football Wizard environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These override values in config.yaml when set.
# .env is in .gitignore — your secrets stay local.

# HeadlessX (REQUIRED — scraping service)
HEADLESSX_API_URL=http://localhost:38473
HEADLESSX_API_KEY=hx_your_api_key_here

# Database
# DATABASE_PATH=data/football-wizard.db

# Logging
# LOG_LEVEL=info       # debug | info | warn | error
# LOG_FORMAT=json      # json | text

# Scheduler
# SCHEDULER_SCRAPE_TIME=01:00
# SCHEDULER_TRAIN_DAY=Sunday
# SCHEDULER_TRAIN_TIME=03:00
